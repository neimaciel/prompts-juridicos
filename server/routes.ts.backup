  // Contract system routes - serve custom HTML page under /docsmart
  
  // Contract system API routes - integrated directly
  app.get('/docsmart/api/health', (req, res) => {
    res.json({ 
      status: 'ok', 
      timestamp: Date.now(),
      service: 'contract-analysis-system-integrated'
    });
  });

  // Authentication endpoints
  app.post('/docsmart/api/auth/register', (req, res) => {
    res.json({ 
      success: false, 
      error: 'Sistema em desenvolvimento - registre-se em breve!' 
    });
