  // Prompt usage statistics endpoint
  app.get("/api/admin/analytics/usage", async (req, res) => {
    try {
      const stats = await storage.getPromptUsageStats();
      res.json(stats);
    } catch (error) {
      console.error("Error fetching usage analytics:", error);
      res.status(500).json({ message: "Failed to fetch usage analytics" });
    }
  });

  // Simple admin authentication
  app.post("/api/admin/login", async (req, res) => {
    try {
      const { email, password } = req.body;
      
      // Simple hardcoded authentication
      if (email === "nei@ampler.me" && password === "Qwe123@#") {
        res.json({ 
          success: true, 
          message: "Login successful",
          user: { email: "nei@ampler.me", role: "admin" }
        });
      } else {
        res.status(401).json({ 
