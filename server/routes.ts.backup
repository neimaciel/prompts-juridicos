  // Analytics endpoints
  app.get("/api/admin/analytics/regions", async (req, res) => {
    try {
      const data = await storage.getPromptsByRegion();
      res.json(data);
    } catch (error) {
      console.error("Error fetching region analytics:", error);
      res.status(500).json({ message: "Failed to fetch region analytics" });
    }
  });

  app.get("/api/admin/analytics/models", async (req, res) => {
    try {
